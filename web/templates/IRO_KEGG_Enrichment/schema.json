  "slots": {
    "ID": {
      "name": "ID",
      "description": "KEGG pathway identifier. Any KEGG entry (pathway, gene, compound, disease, module, etc.)",
      "title": "ID",
      "examples": [
        {
          "value": "hsa04930",
          "description": "KEGG pathway ID (organism-specific)"
        },
        {
          "value": "map00010",
          "description": "KEGG reference pathway ID"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "string",
      "required": true,
      "pattern": "^[A-Za-z]{1,5}[:A-Za-z0-9_]*[0-9]{3,}$"
    },
    "Description": {
      "name": "Description",
      "description": "KEGG pathway full name",
      "title": "Description",
      "examples": [
        {
          "value": "Insulin signaling pathway"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "slot_uri": "schema:name",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "string",
      "required": true
    },
    "setSize": {
      "name": "setSize",
      "description": "number of genes or metabolites in pathway",
      "title": "setSize",
      "examples": [
        {
          "value": "87"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "integer",
      "required": true,
      "minimum_value": 1,
      "maximum_value": 1000
    },
    "enrichmentScore": {
      "name": "enrichmentScore",
      "description": "measure of represented gene presence",
      "title": "enrichmentScore",
      "examples": [
        {
          "value": "0.52"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "float",
      "required": true,
      "minimum_value": -1.0,
      "maximum_value": 1.0
    },
    "NES": {
      "name": "NES",
      "description": "distribution score of genes",
      "title": "NES",
      "examples": [
        {
          "value": "1.9"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "float",
      "required": true,
      "minimum_value": -5.0,
      "maximum_value": 5.0
    },
    "pvalue": {
      "name": "pvalue",
      "description": "statistical significance of KEGG pathway",
      "title": "pvalue",
      "examples": [
        {
          "value": "0.003"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "exact_mappings": [
        "EDAM:data_1669"
      ],
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "float",
      "required": true,
      "minimum_value": 0.0,
      "maximum_value": 0.05
    },
    "p.adjust": {
      "name": "p.adjust",
      "description": "statistical significance of KEGG pathway",
      "title": "p.adjust",
      "examples": [
        {
          "value": "0.012"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "float",
      "required": true,
      "minimum_value": 0.0,
      "maximum_value": 0.05
    },
    "qvalue": {
      "name": "qvalue",
      "description": "statistical significance of KEGG pathway",
      "title": "qvalue",
      "examples": [
        {
          "value": "0.015"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "exact_mappings": [
        "EDAM:data_3932"
      ],
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "float",
      "required": true,
      "minimum_value": 0.0,
      "maximum_value": 0.1
    },
    "rank": {
      "name": "rank",
      "description": "based on how significantly enriched they are given the set of genes",
      "title": "rank",
      "examples": [
        {
          "value": "7"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "close_mappings": [
        "SIO:000367"
      ],
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "integer",
      "required": true,
      "minimum_value": 1
    },
    "leading_edge": {
      "name": "leading_edge",
      "description": "refers to the core genes in a gene set that contribute most to the enrichment score",
      "title": "leading_edge",
      "examples": [
        {
          "value": "tags (80%), list (50%), signal (65%)"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "string",
      "required": true
    },
    "core_enrichment": {
      "name": "core_enrichment",
      "description": "genes that are present in pathway",
      "title": "core_enrichment",
      "examples": [
        {
          "value": "AKT1; IRS1; PIK3CA; PDPK1; FOXO3"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "string",
      "required": true
    },
    "authors": {
      "name": "authors",
      "description": "Names of individuals contributing to the processes of sample collection, sequence generation, analysis, and data submission.",
      "title": "authors",
      "comments": [
        "Include the first and last names of all individuals that should be attributed, separated by a comma."
      ],
      "examples": [
        {
          "value": "William Smith, Sandra Johnson"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "slot_uri": "GENEPIO:0001517",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "WhitespaceMinimizedString",
      "recommended": true
    },
    "dataharmonizer_provenance": {
      "name": "dataharmonizer_provenance",
      "description": "The DataHarmonizer software and template version provenance.",
      "title": "DataHarmonizer Provenance",
      "comments": [
        "The current software and template version information will be automatically generated in this field after the user utilizes the \"validate\" function. This information will be generated regardless as to whether the row is valid of not."
      ],
      "examples": [
        {
          "value": "DataHarmonizer v1.4.3, KEGG_Enrichment v0.1.0"
        }
      ],
      "from_schema": "https://example.org/marbles/kegg/enrichment",
      "slot_uri": "GENEPIO:0001518",
      "domain_of": [
        "IRO_KEGG_Enrichment"
      ],
      "range": "Provenance"
    }
  },
